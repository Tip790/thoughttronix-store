# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# Production hardening. With DEBUG=False all of these default to on (HSTS
# for an hour); with DEBUG=True all are off. On a laptop without HTTPS,
# DEBUG=False also needs the redirect and secure cookies turned off:
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Email. With none of these set, every email prints to the dev server's terminal.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=store@example.com
# EMAIL_HOST_PASSWORD=app-password-here
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ThoughtTronix <no-reply@example.com>
